<?xml version="1.0"?>
<!--
  TamedTable demo voiceover, English, 20 seconds.

  SSML (Speech Synthesis Markup Language) is the standard way to hand a script,
  with pauses / emphasis / pacing, to a good TTS engine. This file targets
  Azure Neural TTS (the <mstts:express-as> style and the voice name are Azure's);
  Google Cloud TTS and Amazon Polly accept the same <break>, <emphasis>, and
  <prosody> tags but ignore the voice/style lines (you pick the voice in their UI).

  The comment before each line is its start time in the video (see the beats in
  demo-video-plan.md). Two ways to line the audio up with the picture:
    A. Tune the <break> values so the running time lands each line on its start.
    B. Better: synthesize each line, then drop them onto a 20s timeline at these
       times and export one voiceover-en.wav — audio.mjs muxes that verbatim.
  Approach B never fights the engine's pacing, so nothing sounds rushed.
-->
<speak version="1.0"
       xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:mstts="https://www.w3.org/2001/mstts"
       xml:lang="en-US">
  <voice name="en-US-AvaMultilingualNeural">
    <mstts:express-as style="friendly" styledegree="1">
      <prosody rate="0%" pitch="0%">

        <!-- 0.0s  open -->
        Talk to your <emphasis level="moderate">data</emphasis>.
        <break time="1400ms"/>

        <!-- 2.0s  the mess -->
        Real data is <emphasis level="moderate">messy</emphasis>.
        <break time="250ms"/>
        Phones need to be normalized based on the country.
        <break time="700ms"/>

        <!-- 6.5s  say it -->
        Just <emphasis level="moderate">say</emphasis> what you want.
        <break time="1100ms"/>

        <!-- 9.0s  watch it -->
        Watch <emphasis level="moderate">every row</emphasis> change,
        <break time="150ms"/>
        right in front of you.
        <break time="1700ms"/>

        <!-- 13.5s  any language -->
        Ask in <emphasis level="strong">any</emphasis> language.
        <break time="250ms"/>
        Same result.
        <break time="900ms"/>

        <!-- 16.0s  keep it -->
        Keep the steps. Replay them free,
        <break time="150ms"/>
        or export to <emphasis level="moderate">Python</emphasis>.

      </prosody>
    </mstts:express-as>
  </voice>
</speak>
