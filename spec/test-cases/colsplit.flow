{
  "version": 1,
  "source": "colsplit-fullname-input.csv",
  "spec": {
    "table": "colsplit-fullname-input.csv",
    "columns": [
      { "id": "ID" },
      { "id": "FullName" },
      { "id": "FirstName" },
      { "id": "LastName" }
    ],
    "transformations": [
      {
        "kind": "split",
        "from": "FullName",
        "into": ["FirstName", "LastName"],
        "on": " "
      }
    ]
  }
}
