{
  "version": 2,
  "source": "pivot-long-input.csv",
  "spec": {
    "table": "pivot-long-input.csv",
    "columns": [
      { "id": "Region" },
      { "id": "Q1" },
      { "id": "Q2" },
      { "id": "Q3" },
      { "id": "Q4" }
    ],
    "transformations": [
      {
        "kind": "pivot",
        "index": ["Region"],
        "on": "Quarter",
        "values": "Revenue",
        "agg": "first"
      }
    ]
  }
}
