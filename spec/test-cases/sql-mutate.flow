{
  "version": 1,
  "source": "datanorm-input.csv",
  "spec": {
    "table": "datanorm-input.csv",
    "columns": [
      { "id": "ID" },
      { "id": "FirstName" },
      { "id": "LastName" },
      { "id": "DOB" },
      { "id": "Country" },
      { "id": "Phone" },
      { "id": "UpperCountry" }
    ],
    "transformations": [
      {
        "kind": "mutate",
        "columns": "UpperCountry",
        "value": { "sql": "upper(Country)" }
      }
    ]
  }
}
