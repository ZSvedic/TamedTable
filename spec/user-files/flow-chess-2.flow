{
  "version": 2,
  "source": "TournamentSearch.csv",
  "spec": {
    "table": "TournamentSearch.csv",
    "columns": [
      {
        "id": "EventGroup"
      },
      {
        "id": "total_players"
      },
      {
        "id": "sections"
      },
      {
        "id": "first_start"
      },
      {
        "id": "last_end"
      },
      {
        "id": "locations"
      },
      {
        "id": "organizers"
      }
    ],
    "transformations": [
      {
        "kind": "mutate",
        "columns": "Tempo igre",
        "value": {
          "llm": "Normalize this chess time-control notation to a standard, concise format. Input time control: '{Tempo igre}'. Use common chess notation such as '90+30' for 90 minutes initial time plus 30 seconds increment per move, '3+2' for blitz, '40/90 + 30' for 40 moves in 90 minutes plus 30 minutes for the rest, and include delay or hourglass only when explicitly stated. Preserve multiple time controls if present, but standardize spacing and symbols. Reply with ONLY the normalized time-control notation and nothing else. If the input is empty, unrecognizable, or cannot be processed, reply with the literal word: null"
        },
        "query": "Kolona Tempo igre je formatirana šaroliko, molim te unificiraj prema uobičajenim šahovskim pravilima za zapisivanje tempa igre."
      },
      {
        "kind": "mutate",
        "columns": "EventGroup",
        "value": {
          "llm": "Cluster this tournament row into the underlying chess event/tournament series it belongs to, even when the row is only one section, category, age group, rating group, round-robin group, or team/individual subgroup. Use the tournament name, organizer, chief arbiter, playing venue/location, federation/state, time control, EventID, and dates as clues. Prefer a concise canonical Croatian/English event name that drops section labels such as A/B/C, U8/U10/U12/U14/U16/U18, Open/rapid/blitz/classical category labels, rating-band labels, round numbers, and team-board subgroups when they appear to be parts of the same event. Tournament name: '{Turnir}'. Organizer(s): '{Organizator(i)}'. Chief arbiter: '{Glavni sudac}'. Location: '{Lokacija}'. Time control: '{Tempo igre}'. Federation: '{FED}'. State: '{State}'. EventID: '{EventID}'. Start date: '{od}'. End date: '{do}'. Same-row context: {*}. Reply with ONLY the canonical event/group name and nothing else. If the input cannot be processed, reply with the literal word: null"
        },
        "query": "Agregiraj po događanju za što se treba koristit heuristika iz imena turnirskih skupina, organizatora, glavnog sudca, mjesta igre, vremena igre i slično te agregirati stupac \"n\" koji je broj igrača i dobiti rang listu najvećih turnira u Hrvatskoj u zadnjih par godina."
      },
      {
        "kind": "filter",
        "pred": {
          "js": "(() => { const fed = String(row.FED ?? '').toUpperCase(); const state = String(row.State ?? '').toUpperCase(); const loc = String(row.Lokacija ?? '').toUpperCase(); return fed === 'CRO' || state === 'CRO' || state.includes('CROATIA') || state.includes('HRVAT') || loc.includes('CROATIA') || loc.includes('HRVATSKA'); })()"
        },
        "query": "Agregiraj po događanju za što se treba koristit heuristika iz imena turnirskih skupina, organizatora, glavnog sudca, mjesta igre, vremena igre i slično te agregirati stupac \"n\" koji je broj igrača i dobiti rang listu najvećih turnira u Hrvatskoj u zadnjih par godina."
      },
      {
        "kind": "filter",
        "pred": {
          "js": "(() => { const cutoffYear = new Date().getFullYear() - 5; const vals = [row.od, row.do, row['Zadnja izmjena']]; for (const v of vals) { const s = String(v ?? '').trim(); if (!s) continue; const m = s.match(/(20\\d{2}|19\\d{2})/); if (m && Number(m[1]) >= cutoffYear) return true; const parts = s.match(/^(\\d{1,2})[.\\/-](\\d{1,2})[.\\/-](\\d{2,4})/); if (parts) { let y = Number(parts[3]); if (y < 100) y += y >= 70 ? 1900 : 2000; if (y >= cutoffYear) return true; } } return false; })()"
        },
        "query": "Agregiraj po događanju za što se treba koristit heuristika iz imena turnirskih skupina, organizatora, glavnog sudca, mjesta igre, vremena igre i slično te agregirati stupac \"n\" koji je broj igrača i dobiti rang listu najvećih turnira u Hrvatskoj u zadnjih par godina."
      },
      {
        "kind": "group",
        "by": [
          "EventGroup"
        ],
        "agg": {
          "total_players": {
            "js": "rows.reduce((sum, r) => { const raw = String(r.n ?? '').replace(/[^0-9,.-]/g, '').replace(',', '.'); const val = Number(raw); return sum + (Number.isFinite(val) ? val : 0); }, 0)"
          },
          "sections": {
            "js": "rows.length"
          },
          "first_start": {
            "js": "rows.reduce((best, r) => { const s = String(r.od ?? '').trim(); return !best || (s && s < best) ? s : best; }, null)"
          },
          "last_end": {
            "js": "rows.reduce((best, r) => { const s = String(r.do ?? '').trim(); return !best || (s && s > best) ? s : best; }, null)"
          },
          "locations": {
            "js": "Array.from(new Set(rows.map(r => String(r.Lokacija ?? '').trim()).filter(Boolean))).slice(0, 5).join('; ')"
          },
          "organizers": {
            "js": "Array.from(new Set(rows.map(r => String(r['Organizator(i)'] ?? '').trim()).filter(Boolean))).slice(0, 5).join('; ')"
          }
        },
        "query": "Agregiraj po događanju za što se treba koristit heuristika iz imena turnirskih skupina, organizatora, glavnog sudca, mjesta igre, vremena igre i slično te agregirati stupac \"n\" koji je broj igrača i dobiti rang listu najvećih turnira u Hrvatskoj u zadnjih par godina."
      },
      {
        "kind": "sort",
        "by": [
          {
            "key": {
              "js": "Number(row.total_players) || 0"
            },
            "dir": "desc"
          }
        ],
        "query": "Agregiraj po događanju za što se treba koristit heuristika iz imena turnirskih skupina, organizatora, glavnog sudca, mjesta igre, vremena igre i slično te agregirati stupac \"n\" koji je broj igrača i dobiti rang listu najvećih turnira u Hrvatskoj u zadnjih par godina."
      }
    ]
  }
}
