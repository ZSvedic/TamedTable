{
  "name": "tamedtable",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun install && bunx playwright install chromium",
    "test": "bun run test:unit && bun run test:headless && bun run test:cli && bun run test:web",
    "test:unit": "bun test",
    "test:headless": "bun --bun cucumber-js --profile headless",
    "test:cli": "bun --bun cucumber-js --profile cli",
    "test:web": "bun --bun cucumber-js --profile web",
    "test:red": "bun --bun cucumber-js --profile red",
    "test:red:unit": "bun test --path-ignore-patterns 'never-match' .red.test",
    "test:smoke": "SMOKE=1 bun test tests/demo.smoke.test.ts tests/demo-config.smoke.test.ts",
    "test:record": "TAMEDTABLE_CASSETTE=record bun run test:headless ; TAMEDTABLE_CASSETTE=record bun run test:cli ; TAMEDTABLE_CASSETTE=record bun run test:web",
    "rerecord": "bun run packages/cassette/rerecord.ts",
    "cassettes:rekey": "bun run packages/cassette/rekey.ts",
    "bench": "bun --bun cucumber-js --profile perf",
    "bench:record": "TAMEDTABLE_CASSETTE=record TAMEDTABLE_BENCH_ALL=1 bun --bun cucumber-js --profile perf",
    "bench:live": "TAMEDTABLE_CASSETTE=off TAMEDTABLE_BENCH_LIVE=1 TAMEDTABLE_BENCH_ALL=1 bun --bun cucumber-js --profile perf",
    "bench:sample": "bun run packages/bench/cli.ts sample",
    "bench:label": "bun run packages/bench/cli.ts label",
    "bench:sweep": "bun run packages/bench/cli.ts sweep",
    "bench:chart": "bun run packages/bench/cli.ts chart",
    "bench:report": "bun run packages/bench/cli.ts report",
    "sync:tokens": "bun run packages/ui-kit/sync-tokens.ts",
    "sync:icons": "bun run packages/ui-kit/sync-icons.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@duckdb/node-api": "1.5.2-r.1",
    "@tamedtable/bench": "workspace:*",
    "@tamedtable/cassette": "workspace:*",
    "@tamedtable/chat-panel": "workspace:*",
    "@tamedtable/cli": "workspace:*",
    "@tamedtable/core": "workspace:*",
    "@tamedtable/file-io": "workspace:*",
    "@tamedtable/gherkin-tour": "workspace:*",
    "@tamedtable/headless": "workspace:*",
    "@tamedtable/model-config": "workspace:*",
    "@tamedtable/table-view": "workspace:*",
    "@tamedtable/ui-kit": "workspace:*",
    "@tamedtable/voice-input": "workspace:*",
    "@tamedtable/web": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "happy-dom": "^20.11.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
